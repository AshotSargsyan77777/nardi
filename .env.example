# =====================================================================
# BAZAR BLOT — environment template. Copy to `.env` and fill in values.
# Never commit real secrets. Generate secrets with: openssl rand -base64 48
# =====================================================================

# ---- Runtime ---------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the web app (CORS, invite links, cookie scope)
WEB_ORIGIN=http://localhost:3000

# ---- Database & cache -----------------------------------------------
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://nardi:CHANGE_ME@localhost:5432/nardi?schema=public
# Optional for a single instance (in-memory fallback), required for multiple instances
REDIS_URL=redis://localhost:6379

# ---- Auth -------------------------------------------------------------
# Required in production (>= 32 chars). Dev falls back to insecure defaults.
JWT_ACCESS_SECRET=
WS_TICKET_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=90
# true in production (HTTPS). Forced on when NODE_ENV=production.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Trusted proxy hops: false | true | number (Nginx compose: 1, Railway: 2)
TRUST_PROXY=false
RATE_LIMIT_PER_MIN=240

# ---- Payments -----------------------------------------------------------
# none | test   (test = sandbox provider, refused when NODE_ENV=production)
PAYMENTS_PROVIDER=none
# HMAC secret shared with the payment provider (>= 16 chars when a provider is enabled)
PAYMENT_WEBHOOK_SECRET=

# ---- Legal gate -----------------------------------------------------------
# Second key for real-money features (mode B, withdrawals). Keep false until a lawyer
# has approved the model for every target jurisdiction and licences/KYC are in place.
LEGAL_MONEY_MODE_APPROVED=false

# ---- Game -----------------------------------------------------------------
BOT_DELAY_MS=900
# password-reset mail through resend.com (empty: mails are only logged)
RESEND_API_KEY=
MAIL_FROM=NARDI <no-reply@example.com>
# Run the matchmaking loop on this instance (enable on exactly one instance)
MATCHMAKER_ENABLED=true

# ---- Web (Next.js) -----------------------------------------------------------
# Where the Next.js server proxies /api/* (build-time for rewrites)
API_INTERNAL_URL=http://localhost:4000
# Override the WebSocket origin (defaults to :4000 in dev, same origin behind a proxy)
NEXT_PUBLIC_WS_URL=

# ---- docker compose ----------------------------------------------------------
HTTP_PORT=8080
