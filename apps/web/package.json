{
  "name": "@nardi/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "if [ -f server.js ]; then HOSTNAME=0.0.0.0 exec node server.js; else exec node scripts/start.mjs; fi",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "npm run build --prefix ../../packages/engine",
    "start:next": "next start -p 3000"
  },
  "dependencies": {
    "@nardi/engine": "*",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-armenian": "^5.3.0",
    "framer-motion": "^12.43.0",
    "next": "15.5.28",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io-client": "^4.8.4",
    "swr": "^2.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  }
}
